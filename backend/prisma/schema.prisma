// ============================================================================
// SoS - Services On Site  |  Prisma Data Model
// ----------------------------------------------------------------------------
// Dev datasource: SQLite (zero-config, file-based) so this runs anywhere.
// Production: change `provider` to "postgresql" and DATABASE_URL to a
// Postgres connection string -- the schema below is already Postgres-safe
// (no SQLite-only features are used).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  PARTNER
  RSA_AGENCY
  ADMIN
  SUPPORT // limited-access admin team member (e.g. customer support); created by an ADMIN, cannot self-register
}

enum AccountStatus {
  PENDING // awaiting OTP verification
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  JOB_COMPLETION
  PHONE_CHANGE
}

enum VehicleType {
  TWO_WHEELER
  THREE_WHEELER
  FOUR_WHEELER_HATCH
  FOUR_WHEELER_SEDAN
  FOUR_WHEELER_SUV
  COMMERCIAL
  TOW_TRUCK_FLATBED
  TOW_TRUCK_CRANE
  NA
}

enum RequestStatus {
  REQUESTED // customer placed the request, searching for a partner
  ASSIGNED // a partner has accepted (= "Accepted" in partner app)
  EN_ROUTE // partner is travelling to the customer
  ARRIVED // partner has reached the location
  IN_PROGRESS // work has started
  COMPLETED
  CANCELLED
  NO_PARTNER_FOUND
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  JOB_OFFER
  STATUS_UPDATE
  PAYMENT
  KYC
  SYSTEM
  PROMO
}

// ----------------------------------------------------------------------------
// CORE IDENTITY
// ----------------------------------------------------------------------------

model User {
  id            String        @id @default(uuid())
  phone         String        @unique // E.164 format, e.g. +91XXXXXXXXXX
  email         String?       @unique
  name          String?
  role          Role
  status        AccountStatus @default(PENDING)
  passwordHash  String? // optional, only used by ADMIN web login as a 2nd factor
  fcmToken      String? // push notification device token
  preferredLang String        @default("en")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customerProfile CustomerProfile?
  partnerProfile  ServicePartner?
  agencyProfile   RsaAgency?

  otps            OtpVerification[]
  notifications   Notification[]
  sentChats       ChatMessage[]      @relation("ChatSender")
  ratingsGiven    Rating[]           @relation("RatingsByCustomer")
  auditLogs       AuditLog[]
  sentBroadcasts  Broadcast[]
  targetedBroadcasts Broadcast[] @relation("BroadcastTarget")

  @@index([role])
}

model OtpVerification {
  id        String     @id @default(uuid())
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?
  phone     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

// ----------------------------------------------------------------------------
// CUSTOMER
// ----------------------------------------------------------------------------

model CustomerProfile {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  savedAddresses  String? // JSON string: [{label, lat, lng, address}]
  defaultVehicle  String? // JSON string: {type, regNumber, model}
  totalRequests   Int      @default(0)
  walletBalance   Float    @default(0)
  createdAt       DateTime @default(now())

  requests ServiceRequest[]
  payments Payment[]
}

// ----------------------------------------------------------------------------
// RSA AGENCY  (optional role: owns/manages a pool of partners)
// ----------------------------------------------------------------------------

model RsaAgency {
  id                 String        @id @default(uuid())
  user               User          @relation(fields: [userId], references: [id])
  userId             String        @unique
  name               String
  registrationNumber String?
  city               City?         @relation(fields: [cityId], references: [id])
  cityId             String?
  status             AccountStatus @default(PENDING)
  createdAt          DateTime      @default(now())

  partners ServicePartner[]
}

// ----------------------------------------------------------------------------
// SERVICE PARTNER  (mechanic / tow / fuel / battery / tyre / key-maker etc.)
// ----------------------------------------------------------------------------

model ServicePartner {
  id          String      @id @default(uuid())
  user        User        @relation(fields: [userId], references: [id])
  userId      String      @unique
  agency      RsaAgency?  @relation(fields: [agencyId], references: [id])
  agencyId    String?
  vehicleType VehicleType @default(NA)
  vehicleRegNumber String?

  // KYC (verified via Cashfree Secure ID in production)
  kycStatus       KycStatus @default(NOT_SUBMITTED)
  kycDocuments    String? // JSON string: [{type, url, verifiedAt}]
  cashfreeRefId   String? // reference id returned by Cashfree verification
  panNumber       String?
  aadhaarLast4    String?
  drivingLicenseNumber String?
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  // Availability + live location
  isOnline      Boolean   @default(false)
  isAvailable   Boolean   @default(false) // online but not on a job
  currentLat    Float?
  currentLng    Float?
  lastLocationAt DateTime?

  // Payout details
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?

  // Aggregates (denormalised for fast read on matching/dashboard)
  avgRating     Float    @default(0)
  totalRatings  Int      @default(0)
  totalJobs     Int      @default(0)
  totalEarnings Float    @default(0)

  city   City?   @relation(fields: [cityId], references: [id])
  cityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services        PartnerService[]
  assignedJobs    ServiceRequest[]   @relation("AssignedPartner")
  ratingsReceived Rating[]           @relation("RatingsForPartner")
  locationHistory LocationPing[]
  payouts         Payout[]

  @@index([isOnline, isAvailable])
  @@index([cityId])
}

// Join table: which service types a partner can fulfil, with optional
// partner-specific override pricing.
model PartnerService {
  id            String      @id @default(uuid())
  partner       ServicePartner @relation(fields: [partnerId], references: [id])
  partnerId     String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId String
  customBasePrice Float?
  isActive      Boolean     @default(true)

  @@unique([partnerId, serviceTypeId])
}

// ----------------------------------------------------------------------------
// SERVICE CATALOG  (modular -- admin can add new service types without a
// code deploy, satisfying the "add more services later" requirement)
// ----------------------------------------------------------------------------

model ServiceType {
  id              String   @id @default(uuid())
  code            String   @unique // FLAT_TIRE, BATTERY_JUMPSTART, FUEL_DELIVERY...
  name            String
  description     String?
  icon            String? // icon key used by the apps
  basePrice       Float
  pricePerKm      Float    @default(0)
  estimatedMins   Int      @default(20)
  isActive        Boolean  @default(true)
  isEmergencySos  Boolean  @default(false)
  createdAt       DateTime @default(now())

  partnerServices PartnerService[]
  requests        ServiceRequest[]
  pricingRules    PricingRule[]
}

// City-level / surge pricing overrides, enabling multi-city expansion.
model City {
  id        String   @id @default(uuid())
  name      String
  stateName String?
  code      String   @unique
  centerLat Float? // service-area geofence: circle center + radius (km)
  centerLng Float?
  radiusKm  Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  partners     ServicePartner[]
  agencies     RsaAgency[]
  pricingRules PricingRule[]
}

model PricingRule {
  id               String      @id @default(uuid())
  city             City?       @relation(fields: [cityId], references: [id])
  cityId           String?
  serviceType      ServiceType @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId    String
  basePrice        Float
  pricePerKm       Float       @default(0)
  surgeMultiplier  Float       @default(1.0)
  nightMultiplier  Float       @default(1.0) // applied 10pm-6am
  minFare          Float       @default(0)
  effectiveFrom    DateTime    @default(now())
  isActive         Boolean     @default(true)

  @@index([cityId, serviceTypeId])
}

// ----------------------------------------------------------------------------
// SERVICE REQUEST  (the core job lifecycle)
// ----------------------------------------------------------------------------

model ServiceRequest {
  id            String        @id @default(uuid())
  requestNumber String        @unique // human readable, e.g. SOS-2026-000123

  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  customerId String

  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId String

  assignedPartner   ServicePartner? @relation("AssignedPartner", fields: [assignedPartnerId], references: [id])
  assignedPartnerId String?

  status RequestStatus @default(REQUESTED)
  isSos  Boolean       @default(false)

  pickupLat     Float
  pickupLng     Float
  pickupAddress String?
  destinationLat Float? // optional, used for towing drop-off
  destinationLng Float?
  destinationAddress String?

  vehicleDetails String? // JSON: {type, regNumber, model, color}
  customerNotes  String?

  estimatedPrice   Float
  finalPrice       Float?
  estimatedEtaMins Int?
  distanceKm       Float?

  completionOtp           String?
  completionOtpVerifiedAt DateTime?

  cancelReason String?
  cancelledBy  String? // userId

  requestedAt DateTime  @default(now())
  assignedAt  DateTime?
  enRouteAt   DateTime?
  arrivedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  delayFlaggedAt DateTime? // set once by the delay-monitor sweep when a request blows past its ETA + grace buffer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory StatusHistory[]
  payment       Payment?
  rating        Rating?
  chatMessages  ChatMessage[]

  @@index([status])
  @@index([assignedPartnerId])
  @@index([customerId])
}

model StatusHistory {
  id        String         @id @default(uuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  requestId String
  status    RequestStatus
  changedAt DateTime       @default(now())
  changedBy String? // userId or "SYSTEM"
  notes     String?

  @@index([requestId])
}

// ----------------------------------------------------------------------------
// PAYMENTS  (Razorpay -- prepaid only: UPI / Card / Netbanking / Wallet)
// ----------------------------------------------------------------------------

model Payment {
  id         String          @id @default(uuid())
  request    ServiceRequest  @relation(fields: [requestId], references: [id])
  requestId  String          @unique
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  customerId String

  amount   Float
  currency String        @default("INR")
  method   PaymentMethod
  gateway  String        @default("RAZORPAY")

  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?

  status PaymentStatus @default(CREATED)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Partner payouts (settlement of earnings out to bank/UPI)
model Payout {
  id        String         @id @default(uuid())
  partner   ServicePartner @relation(fields: [partnerId], references: [id])
  partnerId String
  amount    Float
  status    PaymentStatus  @default(PENDING)
  reference String?
  periodFrom DateTime
  periodTo   DateTime
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// RATINGS & REVIEWS
// ----------------------------------------------------------------------------

model Rating {
  id        String   @id @default(uuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  requestId String   @unique

  customer   User   @relation("RatingsByCustomer", fields: [customerId], references: [id])
  customerId String
  partner    ServicePartner @relation("RatingsForPartner", fields: [partnerId], references: [id])
  partnerId  String

  rating          Int // 1-5
  review          String?
  partnerResponse String?
  createdAt       DateTime @default(now())

  @@index([partnerId])
}

// ----------------------------------------------------------------------------
// LIVE LOCATION  (location pings for real-time tracking / history trail)
// ----------------------------------------------------------------------------

model LocationPing {
  id         String         @id @default(uuid())
  partner    ServicePartner @relation(fields: [partnerId], references: [id])
  partnerId  String
  lat        Float
  lng        Float
  heading    Float?
  speedKmph  Float?
  requestId  String? // tagged to an active job, if any
  recordedAt DateTime       @default(now())

  @@index([partnerId, recordedAt])
}

// ----------------------------------------------------------------------------
// CHAT  (in-app chat between customer & partner, scoped to a request)
// ----------------------------------------------------------------------------

model ChatMessage {
  id        String         @id @default(uuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  requestId String
  sender    User           @relation("ChatSender", fields: [senderId], references: [id])
  senderId  String
  message   String
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  type      NotificationType
  title     String
  body      String
  data      String? // JSON payload (e.g. requestId for deep-linking)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// Admin-sent broadcast announcements (push + in-app), fanned out to
// individual Notification rows for each targeted recipient at send time.
model Broadcast {
  id              String   @id @default(uuid())
  title           String
  body            String
  audience        String // ALL | CUSTOMERS | PARTNERS | USER
  targetUser      User?    @relation("BroadcastTarget", fields: [targetUserId], references: [id])
  targetUserId    String?  // set when audience = USER (a single specific recipient)
  sentBy          User     @relation(fields: [sentById], references: [id])
  sentById        String
  recipientCount  Int
  pushSentCount   Int      @default(0)
  sentAt          DateTime @default(now())
}

// ----------------------------------------------------------------------------
// EVENT-DRIVEN NOTIFICATION RULES
// One row per (event, channel) pair, e.g. id "ORDER_CONFIRMED:EMAIL". The
// admin dashboard's Notification Rules page toggles `enabled` and edits
// `subject`/`message` per row; `event-notifier.service.js` reads these at
// the moment a lifecycle event actually fires.
// ----------------------------------------------------------------------------

model NotificationRule {
  id        String   @id // composite key, e.g. "ORDER_CONFIRMED:EMAIL"
  event     String   // SIGNUP | LOGIN | ORDER_CONFIRMED | ORDER_COMPLETED | ORDER_DELAYED | ORDER_CANCELLED
  channel   String   // EMAIL | SMS | WHATSAPP | ALERT
  enabled   Boolean  @default(false)
  subject   String?  // email only; null for SMS/WhatsApp/Alert
  message   String   // template body, supports {{name}} {{requestNumber}} {{serviceName}} {{amount}} {{partnerName}} {{cancelReason}}
  updatedAt DateTime @updatedAt
  updatedBy String?  // admin userId, null if never edited from its seeded default

  @@index([event])
}

// Every actual dispatch attempt (sent, skipped, or failed) for visibility --
// distinct from the audit log, which records admin actions, not automated
// customer/partner-facing sends.
model NotificationDispatchLog {
  id        String   @id @default(uuid())
  event     String
  channel   String
  userId    String?
  requestId String?
  recipient String?  // email address, phone number, or userId depending on channel
  subject   String?
  message   String
  ok        Boolean
  reason    String?  // why it failed or was skipped, e.g. "No email address on file"
  createdAt DateTime @default(now())

  @@index([event])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// AUDIT LOG  (admin actions: approvals, manual reassignment, price changes)
// ----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String // e.g. "PARTNER_APPROVED", "REQUEST_REASSIGNED"
  entityType String
  entityId   String
  details    String? // JSON
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
